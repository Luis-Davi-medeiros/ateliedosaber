# ===================================================
# ATELIÊ DO SABER - VARIÁVEIS DE AMBIENTE (PRODUÇÃO)
# ===================================================

# 1. Obtenha seu Token no Mercado Pago Developers:
# Acesse: https://www.mercadopago.com.br/developers/panel/app
# Crie uma aplicação -> Credenciais de Produção ou Testes -> copie o "Access Token"
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SEU_ACCESS_TOKEN_AQUI

# 2. URL do seu site em produção para receber notificações de pagamento:
# Exemplo: https://ateliedosaber.vercel.app/api/webhook
NOTIFICATION_URL=https://seu-dominio.com/api/webhook

# 3. Chave pública (opcional se for usar SDK de cartão transparente no futuro)
MERCADO_PAGO_PUBLIC_KEY=APP_USR-SUA_PUBLIC_KEY_AQUI
